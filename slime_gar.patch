+from slime.rollout.rm_hub.deepscaler import get_deepscaler_rule_based_reward
+
+
+def test_deepscaler_supports_think_format():
+    response = "<think>Compute carefully.</think><answer>42</answer>"
+    assert get_deepscaler_rule_based_reward(response, "42") == 1
+
+
+def test_deepscaler_supports_response_header_format():
+    response = "###Response\nAnswer: \\boxed{42}"
+    assert get_deepscaler_rule_based_reward(response, "42") == 1
+
+
+def test_deepscaler_supports_plain_base_model_format():
+    response = "We solve it directly.\n<answer>42</answer>"
+    assert get_deepscaler_rule_based_reward(response, "42") == 1
+
+
+def test_deepscaler_supports_answer_tag_with_boxed_content():
+    response = "<think>Compute carefully.</think><answer>\\boxed{42}</answer>"
+    assert get_deepscaler_rule_based_reward(response, "42") == 1
+
+
+def test_deepscaler_supports_answer_tag_with_answer_prefix():
+    response = "<think>Compute carefully.</think><answer>Answer: \\boxed{42}</answer>"
+    assert get_deepscaler_rule_based_reward(response, "42") == 1
+
+
+def test_deepscaler_supports_plain_answer_prefix_without_tags():
+    response = "We solve it directly.\nAnswer: 42"
+    assert get_deepscaler_rule_based_reward(response, "42") == 1
+
+
+def test_deepscaler_rejects_wrong_answer():
+    response = "We solve it directly.\n<answer>41</answer>"
+    assert get_deepscaler_rule_based_reward(response, "42") == 0
