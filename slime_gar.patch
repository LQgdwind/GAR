index 00000000..3ac68dee
--- /dev/null
+++ b/tests/test_gar_online_reward.py
@@ -0,0 +1,105 @@
+import torch
+
+from slime_plugins.gar.online_reward import (
+    _compute_local_response_spans,
+    _compute_response_spans,
+    _compute_sequence_shard_bounds,
+    _compute_single_sample_pad,
+    _gather_hidden_states_across_tp,
+    _get_effective_response_length,
+    _get_unwrapped_model_module,
+    _slice_response_hidden_and_targets,
+)
+
+
+class _LeafModule(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.output_layer = torch.nn.Linear(4, 4, bias=False)
+
+
+class _WrapperModule(torch.nn.Module):
+    def __init__(self, module):
+        super().__init__()
+        self.module = module
+
+
+def test_get_unwrapped_model_module_unwraps_nested_module_chain():
+    leaf = _LeafModule()
+    chunk = _WrapperModule(_WrapperModule(leaf))
+
+    resolved = _get_unwrapped_model_module(chunk)
+
+    assert resolved is leaf
+    assert hasattr(resolved, "output_layer")
+
+
+def test_compute_single_sample_pad_matches_expected_multiple():
+    assert _compute_single_sample_pad(513, 256) == 255
+    assert _compute_single_sample_pad(512, 256) == 0
+
+
+def test_compute_response_spans_respects_max_response_tokens():
+    hidden_start, hidden_end, token_start, token_end = _compute_response_spans(
+        total_length=20,
+        response_length=8,
+        max_response_tokens=3,
+    )
+
+    assert (hidden_start, hidden_end) == (16, 19)
+    assert (token_start, token_end) == (17, 20)
+    assert _get_effective_response_length(8, 3) == 3
+
+
+def test_compute_local_response_spans_returns_overlap_only():
+    shard_start, shard_end = _compute_sequence_shard_bounds(padded_length=16, tp_rank=1, tp_size=2)
+
+    spans = _compute_local_response_spans(
+        hidden_start=6,
+        hidden_end=11,
+        shard_start=shard_start,
+        shard_end=shard_end,
+    )
+
+    assert spans == (0, 3, 9, 12)
+
+
+def test_slice_response_hidden_and_targets_supports_sequence_parallel_shard(monkeypatch):
+    monkeypatch.setattr("slime_plugins.gar.online_reward.mpu.get_tensor_model_parallel_world_size", lambda: 2)
+    monkeypatch.setattr("slime_plugins.gar.online_reward.mpu.get_tensor_model_parallel_rank", lambda: 1)
+
+    hidden_states = torch.arange(8 * 1 * 4, dtype=torch.float32).reshape(8, 1, 4)
+    full_tokens = torch.arange(12, dtype=torch.long)
+
+    response_hidden, response_tokens = _slice_response_hidden_and_targets(
+        hidden_states=hidden_states,
+        full_tokens=full_tokens,
+        padded_length=16,
+        response_length=5,
+        max_response_tokens=0,
+    )
+
+    assert response_hidden.shape == (3, 1, 4)
+    assert response_tokens.tolist() == [9, 10, 11]
+    assert torch.equal(response_hidden[:, 0, 0], torch.tensor([0.0, 4.0, 8.0]))
+
+
+def test_gather_hidden_states_across_tp_reconstructs_full_sequence(monkeypatch):
+    monkeypatch.setattr("slime_plugins.gar.online_reward.mpu.get_tensor_model_parallel_world_size", lambda: 2)
+    monkeypatch.setattr("slime_plugins.gar.online_reward.mpu.get_tensor_model_parallel_rank", lambda: 1)
+    monkeypatch.setattr("slime_plugins.gar.online_reward.mpu.get_tensor_model_parallel_group", lambda: "tp-group")
+
+    local_hidden = torch.arange(8 * 1 * 4, dtype=torch.float32).reshape(8, 1, 4)
+
+    def _fake_all_gather(output_tensors, input_tensor, group):
+        assert group == "tp-group"
+        output_tensors[0].copy_(torch.full_like(input_tensor, -1.0))
+        output_tensors[1].copy_(input_tensor)
+
+    monkeypatch.setattr("slime_plugins.gar.online_reward.dist.all_gather", _fake_all_gather)
+
+    gathered_hidden = _gather_hidden_states_across_tp(local_hidden, padded_length=16)
+
+    assert gathered_hidden.shape == (16, 1, 4)
+    assert torch.equal(gathered_hidden[:8], torch.full((8, 1, 4), -1.0))
+    assert torch.equal(gathered_hidden[8:], local_hidden)
